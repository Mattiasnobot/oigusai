# ============================================================
# ÕigusAI konfiguratsioon
# Kopeeri see fail nimega .env ja muuda väärtusi vastavalt masinale.
# ============================================================

# --- FastAPI ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=INFO
# Kui rakendus on võrgust ligipääsetav, määra vähemalt 8 märgi pikkune kood.
APP_ACCESS_CODE=
APP_RATE_LIMIT_PER_MINUTE=30
APP_UPLOAD_LIMIT_PER_MINUTE=6
APP_MAX_CONCURRENT_WORK=1
APP_MAX_QUEUED_WORK=8
APP_QUEUE_TIMEOUT=360
MATTER_TTL_MINUTES=120

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_TIMEOUT=300

# Mudeli genereerimine
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1536
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m

# Kui esimene vastus ei sisalda korrektseid viiteid, mitu paranduspäringut teha.
OLLAMA_CITATION_RETRIES=2

# V8: skannitud PDF-ide ja piltide lokaalne OCR
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_OCR_TIMEOUT=180

# Production/runtime puhul hoia false.
ALLOW_MOCK_ANALYSIS=false

# --- Õigusallikate otsing ---
LEGAL_DATA_FILE=data/laws.json
LEGAL_MIN_SCORE=6
LEGAL_MAX_RESULTS=5
# Tulemus peab saama vähemalt selle osa parima tulemuse skoorist.
LEGAL_RELATIVE_THRESHOLD=0.6

# Runtime live-RT fallback on vaikimisi keelatud; eelista imporditud korpust.
ALLOW_LIVE_RT_FALLBACK=false

# --- V5: loomuliku päringu mõistmine ---
# Fuzzy/parandused mõjutavad ainult retrieval'i, mitte õigusväidete tõendamist.
QUERY_UNDERSTANDING_ENABLED=true
# Auditeeritav Eesti loomuliku keele retrieval-lexicon.
QUERY_LEXICON_FILE=data/query_lexicon.json
# Minimaalne sarnasusskoor (0.82 on konservatiivne algväärtus).
QUERY_FUZZY_THRESHOLD=0.82
# Mitu fuzzy kandidaati ühe kasutaja tokeni kohta võib lisada.
QUERY_FUZZY_MAX_MATCHES=1
# Lühemaid sõnu automaatselt ei parandata, et vähendada valepositiivseid vasteid.
QUERY_FUZZY_MIN_TOKEN_LENGTH=5
# Maksimaalne retrieval'ile lisatavate terminite arv.
QUERY_MAX_EXPANDED_TERMS=16
# Kas "abi politseinik" tüüpi väljendeid proovida korpuse liitsõnaks ühendada.
QUERY_COMPOUND_ENABLED=true
# Väike ranking-boonus, kui parandatud termin viitab üheselt kindlale õigusaktile.
QUERY_DOMAIN_HINT_BONUS=2
QUERY_CURATED_DOMAIN_HINT_BONUS=18

# --- V6: kohalik hübriidotsing ---
# Kui indeks puudub või ei vasta korpusele, jätkab rakendus automaatselt V5 otsinguga.
HYBRID_RETRIEVAL_ENABLED=true
VECTOR_INDEX_DIR=data/lancedb
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT=180
EMBEDDING_BATCH_SIZE=64
EMBEDDING_KEEP_ALIVE=30m
# Ühe paragrahvi embeddingusse mineva teksti maksimaalne pikkus märkides.
EMBEDDING_MAX_CHARS=6000
HYBRID_DENSE_CANDIDATES=60
HYBRID_RRF_K=20
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_DENSE_WEIGHT=1.0
HYBRID_DIVERSITY_WEIGHT=0.75
HYBRID_MULTI_QUERY_ENABLED=true
HYBRID_MAX_QUERY_VARIANTS=3

# --- V6.1: kohalik kandidaatide reranker ---
# Mudel järjestab ainult V6 leitud kontrollitud korpusekirjeid.
# Kui laadimine või hindamine ebaõnnestub, jääb V6 järjestus automaatselt alles.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_CANDIDATES=20
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_MAX_CHARS=5000
RERANKER_WEIGHT=2.0

# --- Riigi Teataja ---
RT_BASE_URL=https://www.riigiteataja.ee
RT_REGISTRY_FILE=data/rt_registry.json
RT_CACHE_DIR=data/.rt_cache
RT_SERVICE_CACHE_DIR=cache/rt
RT_TIMEOUT=45
RT_RETRIES=3
RT_REQUEST_DELAY=0.5
RT_CACHE_TTL_DAYS=7
RT_USER_AGENT=OigusAI/0.9.1 (local legal analysis prototype)

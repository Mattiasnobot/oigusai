+        })
+
+        analysis, claims, diagnostics = service.prepare_structured_repair_response(
+            raw, laws, "test"
+        )
+
+        self.assertEqual(analysis, "")
+        self.assertEqual(claims, [])
+        self.assertEqual(diagnostics["evidence_recovered_count"], 0)
+        self.assertEqual(
